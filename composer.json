{
    "name": "taptap-pay/sdk",
    "description": "Official PHP SDK for the TapTap-Pay API",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://taptap.rs",
    "keywords": ["taptap", "taptap-pay", "payments", "sdk", "connectrpc"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "google/protobuf": "^4.28",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "TapTap\\Pay\\": "src/"
        },
        "classmap": [
            "gen/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TapTap\\Pay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true
    }
}
